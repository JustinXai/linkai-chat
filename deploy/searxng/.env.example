# SearXNG Configuration for Link-AI Chat
# Copy this file to .env and modify as needed

# SearXNG 实例地址 (只监听本机)
SEARXNG_INSTANCE_URL=http://127.0.0.1:8888

# 生成随机密钥的方式:
# Linux/Mac: head -c 32 /dev/urandom | base64
# Windows PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) | ForEach-Object { [byte]$_ })
SEARXNG_SECRET_KEY=change-this-to-a-random-string-in-production
